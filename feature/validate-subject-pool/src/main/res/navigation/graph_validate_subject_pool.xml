<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_validate_subject_pool"
    app:startDestination="@id/validateSubjectPoolFragment">

    <fragment
        android:id="@+id/validateSubjectPoolFragment"
        android:name="com.simprints.feature.validatepool.screen.ValidateSubjectPoolFragment"
        android:label="ValidateSubjectPoolFragment"
        tools:layout="@layout/fragment_validate_subject_pool">

        <argument
            android:name="params"
            app:argType="com.simprints.core.domain.step.StepParams" />

        <action
            android:id="@+id/action_validateSubjectPoolFragment_to_moduleSelectionFragment"
            app:destination="@id/moduleSelectionFragment" />

    </fragment>

    <fragment
        android:id="@+id/moduleSelectionFragment"
        android:name="com.simprints.feature.moduleselector.ModuleSelectorFragment"
        android:label="ModuleSelectionFragment" />

</navigation>
